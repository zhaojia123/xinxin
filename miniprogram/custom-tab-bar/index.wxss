.bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; background: #fff; border-top: 1rpx solid #e6eaf0; padding: 16rpx 60rpx calc(12rpx + env(safe-area-inset-bottom)); z-index: 10; }
.tab { width: 50%; display: flex; flex-direction: column; align-items: center; color: #8691a3; font-size: 23rpx; line-height: 1.5; }
.selected { color: #2457e6; font-weight: 600; }
.icon { position: relative; width: 42rpx; height: 42rpx; margin: 2rpx 0 9rpx; box-sizing: border-box; }
.book { border: 3rpx solid currentColor; border-radius: 8rpx; }
.book view { position: absolute; left: 8rpx; top: 0; bottom: 0; border-left: 3rpx solid currentColor; }
.book text { position: absolute; left: 17rpx; top: 12rpx; width: 13rpx; height: 8rpx; border-top: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; }
.people view { position: absolute; left: 13rpx; top: 0; width: 16rpx; height: 16rpx; border: 3rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.people text { position: absolute; left: 5rpx; bottom: 0; width: 32rpx; height: 21rpx; border: 3rpx solid currentColor; border-radius: 18rpx 18rpx 5rpx 5rpx; box-sizing: border-box; }
