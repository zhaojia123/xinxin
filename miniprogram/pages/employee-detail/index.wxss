.employee-hero { text-align: center; padding: 42rpx 30rpx; }.employee-avatar { width: 100rpx; height: 100rpx; line-height: 100rpx; margin: 0 auto; border-radius: 30rpx; background: #edf2ff; color: #2457e6; font-size: 45rpx; font-weight: 700; }.employee-hero-name { margin-top: 20rpx; font-size: 36rpx; font-weight: 700; }.employee-hero-meta { margin-top: 10rpx; color: #718096; font-size: 24rpx; }
.detail-row { display: flex; justify-content: space-between; gap: 26rpx; padding: 24rpx 0; border-bottom: 1rpx solid #f0f2f7; color: #475467; }.detail-row:last-child { border-bottom: 0; padding-bottom: 0; }.detail-row text:last-child { color: #162033; text-align: right; word-break: break-all; }.detail-remark { margin-top: 22rpx; color: #475467; line-height: 1.8; white-space: pre-wrap; }.active { color: #16825d !important; }.warning { color: #b54708 !important; }.inactive { color: #dc5c50 !important; }.pending { color: #2457e6 !important; }
.employee-doc-list { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 22rpx; }.employee-doc-item { width: 190rpx; }.employee-doc-item image { width: 190rpx; height: 150rpx; border-radius: 16rpx; background: #f2f5fa; }.employee-doc-title { margin-top: 8rpx; color: #475467; font-size: 22rpx; }.employee-doc-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 24rpx; }.employee-doc-actions button { margin: 0; }
