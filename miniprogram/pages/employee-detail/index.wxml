<view class="page form-page">
  <view class="eyebrow">员工档案</view><view class="title">员工详情</view><view class="subtitle">查看这位伙伴的完整资料。</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="load">重新加载</button></view>
  <view wx:if="{{!ready && !error}}" class="loading">正在加载…</view>
  <block wx:if="{{ready}}">
    <view class="employee-hero card"><view class="employee-avatar">{{employee.initial}}</view><view class="employee-hero-name">{{employee.name}}</view><view class="employee-hero-meta">{{employee.employee_no}} · {{employee.status_label}}</view></view>
    <view class="card"><view class="section-title">基本资料</view><view class="detail-row"><text>性别</text><text>{{employee.gender_label}}</text></view><view class="detail-row"><text>手机号</text><text>{{employee.mobile || '未填写'}}</text></view><view class="detail-row"><text>身份证号</text><text>{{employee.id_card || '未填写'}}</text></view><view class="detail-row"><text>学历</text><text>{{employee.education || '未填写'}}</text></view><view class="detail-row"><text>籍贯</text><text>{{employee.hometown || '未填写'}}</text></view></view>
    <view class="card"><view class="section-title">岗位与任职</view><view class="detail-row"><text>部门</text><text>{{employee.department || '未分配部门'}}</text></view><view class="detail-row"><text>岗位</text><text>{{employee.position || '未分配岗位'}}</text></view><view class="detail-row"><text>在职状态</text><text>{{employee.status_label}}</text></view><view class="detail-row"><text>用工类型</text><text>{{employee.employment_type_label}}</text></view><view class="detail-row"><text>计薪方式</text><text>{{employee.pay_basis === 'hourly' ? '时薪' : (employee.pay_basis === 'daily' ? '日薪' : '月薪')}}</text></view><view class="detail-row"><text>入职时工资</text><text>{{employee.entry_salary || '未填写'}}</text></view><view class="detail-row"><text>当前工资</text><text>{{employee.current_salary || '未填写'}}</text></view></view>
    <view class="card"><view class="section-title">重要日期</view><view class="detail-row"><text>入职日期</text><text>{{employee.joined_on || '未填写'}}</text></view><view class="detail-row"><text>转正日期</text><text>{{employee.regularized_on || '未填写'}}</text></view><view class="detail-row"><text>离职日期</text><text>{{employee.left_on || '未填写'}}</text></view></view>
    <view class="card"><view class="section-title">健康证</view><view class="detail-row"><text>状态</text><text class="{{employee.health_certificate_status_class}}">{{employee.health_certificate_status}}</text></view><view class="detail-row"><text>发证日期</text><text>{{employee.health_certificate_issued_on || '未填写'}}</text></view><view class="detail-row"><text>到期日期</text><text>{{employee.health_certificate_expires_on || '未填写'}}</text></view><view wx:if="{{employee.health_certificate_url}}" class="detail-remark">证件附件：{{employee.health_certificate_url}}</view></view>
    <view class="card"><view class="row"><view class="section-title">证件图片</view><text wx:if="{{canEdit}}" class="muted">可重复上传更新</text></view><view class="employee-doc-list"><view wx:for="{{employee.attachments}}" wx:key="id" class="employee-doc-item"><image src="{{item.file_url}}" mode="aspectFill"/><view class="employee-doc-title">{{item.title}}</view></view></view><view wx:if="{{canEdit}}" class="employee-doc-actions"><button class="secondary small-button" data-kind="id_card_front" bindtap="uploadDocument" disabled="{{uploadingType}}">身份证人像面</button><button class="secondary small-button" data-kind="id_card_back" bindtap="uploadDocument" disabled="{{uploadingType}}">身份证国徽面</button><button class="secondary small-button" data-kind="health_certificate_front" bindtap="uploadDocument" disabled="{{uploadingType}}">健康证正面</button><button class="secondary small-button" data-kind="health_certificate_back" bindtap="uploadDocument" disabled="{{uploadingType}}">健康证反面</button></view></view>
    <view class="card"><view class="section-title">备注</view><view class="detail-remark">{{employee.remark || '未填写备注'}}</view></view>
  </block>
  <view class="form-footer"><button class="secondary" bindtap="back">返回列表</button><button wx:if="{{ready && canEdit}}" class="primary" bindtap="edit">编辑员工资料</button></view>
</view>
