.home-page { min-height: 100vh; box-sizing: border-box; padding: 52rpx 34rpx calc(56rpx + env(safe-area-inset-bottom)); background: linear-gradient(155deg,#f8faff 0%,#eef3ff 52%,#f7f9fd 100%); color: #172440; }
.hero { padding: 20rpx 12rpx 48rpx; }.brand-row { display: flex; align-items: center; gap: 18rpx; }.brand-mark { width: 76rpx; height: 76rpx; border-radius: 24rpx; background: linear-gradient(145deg,#3d71f3,#173aa1); color: #fff; line-height: 76rpx; text-align: center; font-size: 38rpx; font-weight: 700; }.product-name { font-size: 28rpx; font-weight: 700; }.product-subtitle { margin-top: 6rpx; color: #7b89a4; font-size: 21rpx; }.eyebrow { display: inline-block; margin-top: 54rpx; padding: 10rpx 18rpx; border-radius: 99rpx; background: rgba(255,255,255,.7); color: #2457e6; font-size: 22rpx; font-weight: 600; }.home-title { margin-top: 24rpx; font-size: 54rpx; font-weight: 700; line-height: 1.28; letter-spacing: -2rpx; }.home-title text { color: #2457e6; }.home-intro { margin-top: 22rpx; color: #63718b; font-size: 27rpx; line-height: 1.75; }
.section-title { margin: 4rpx 12rpx 20rpx; font-size: 30rpx; font-weight: 700; }.feature-card { display: flex; align-items: center; min-height: 124rpx; margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #e4eaf5; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(30,54,103,.06); }.feature-icon { width: 64rpx; height: 64rpx; flex: 0 0 64rpx; margin-right: 20rpx; border-radius: 18rpx; color: #fff; background: #2457e6; text-align: center; line-height: 64rpx; font-weight: 700; }.feature-icon.green { background: #28a36a; }.feature-copy { flex: 1; }.feature-copy view { font-size: 29rpx; font-weight: 700; }.feature-copy text { display: block; margin-top: 8rpx; color: #72809a; font-size: 23rpx; line-height: 1.5; }.arrow { color: #9aa8bd; font-size: 42rpx; }
.privacy-card { margin-top: 34rpx; padding: 24rpx; border-radius: 20rpx; background: #f2f6ff; color: #63718b; font-size: 23rpx; line-height: 1.7; }.privacy-title { margin-bottom: 6rpx; color: #2d4777; font-size: 26rpx; font-weight: 700; }.home-button { width: 100%; margin-top: 30rpx; border-radius: 20rpx; font-size: 29rpx; }.filing-info { margin-top: 22rpx; color: #a0aabc; font-size: 20rpx; text-align: center; }
