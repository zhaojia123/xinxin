<view class="page">
  <view class="row"><view><view class="eyebrow">欣欣的日常记录</view><view class="title">日常台账</view></view><button class="link" bindtap="logout">退出</button></view>
  <view class="subtitle">把每一笔日常，记得明明白白。</view>
  <view class="overview">
    <view class="row"><text class="overview-label">筛选区间净收支</text><button class="month-reset" bindtap="currentMonth">本月</button></view>
    <view class="date-range"><picker mode="date" value="{{start_date}}" data-field="start_date" bindchange="dateChanged"><view class="date-picker">{{start_date}}</view></picker><text>至</text><picker mode="date" value="{{end_date}}" data-field="end_date" bindchange="dateChanged"><view class="date-picker">{{end_date}}</view></picker></view>
    <view class="net">{{summary ? summary.month_net : '—'}}</view>
    <view class="overview-bottom"><view><view class="overview-label">区间结束日结存</view><view class="balance">{{summary ? summary.current_balance : '—'}}</view></view><view class="overview-seal">记</view></view>
  </view>
  <view class="totals"><view class="total"><view class="muted">↗ 区间收入</view><view class="total-amount positive">{{summary ? summary.month_income : '—'}}</view></view><view class="total"><view class="muted">↘ 区间支出</view><view class="total-amount negative">{{summary ? summary.month_expense : '—'}}</view></view></view>
  <view class="row records-heading"><view class="section-title">收支明细</view><button wx:if="{{canCreate}}" class="primary small-button" bindtap="add">＋ 记一笔</button></view>
  <view class="search"><input placeholder="搜索摘要、对方名称" value="{{q}}" bindinput="search" maxlength="128" confirm-type="search"/></view>
  <view class="filters"><view class="filter {{direction === '' ? 'active' : ''}}" data-value="" bindtap="filter">全部</view><view class="filter {{direction === 'income' ? 'active' : ''}}" data-value="income" bindtap="filter">收入</view><view class="filter {{direction === 'expense' ? 'active' : ''}}" data-value="expense" bindtap="filter">支出</view></view>
  <view class="entry" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="detail">
    <view class="entry-top"><view class="entry-icon {{item.direction}}">{{item.badge}}</view><view class="entry-main"><view class="entry-title">{{item.summary}}</view><view class="entry-meta">{{item.category || '未分类'}} · {{item.account}}</view></view><view class="entry-amount {{item.direction === 'income' ? 'positive' : 'negative'}}">{{item.sign}}{{item.amount}}</view></view>
    <view class="entry-bottom"><text>{{item.occurred_on}}<text wx:if="{{item.counterparty}}"> · {{item.counterparty}}</text></text><view class="entry-actions"><text class="detail-label" catchtap="detail" data-id="{{item.id}}">详情 ›</text><text wx:if="{{canEdit && !item.payroll_batch_id}}" class="edit-label" catchtap="edit" data-id="{{item.id}}">编辑 ›</text><button wx:if="{{canDelete && !item.payroll_batch_id}}" class="mini-danger" catchtap="remove" data-id="{{item.id}}">删除</button></view></view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="retry">重新加载</button></view>
  <view wx:if="{{loading}}" class="loading">正在整理账目…</view>
  <view wx:if="{{loaded && !records.length && !loading && !error}}" class="empty card"><view class="empty-mark">记</view><view class="empty-title">{{q || direction ? '没有找到匹配的记录' : '这个区间暂无台账'}}</view><view>{{q || direction ? '试试其他关键词或收支类型' : '当前账号只有查看权限'}}</view><button wx:if="{{canCreate}}" class="link" bindtap="add">＋ 添加收支</button></view>
  <view wx:if="{{loaded && records.length && !more && !loading}}" class="end">本次筛选的记录都在这里了</view>
</view>
