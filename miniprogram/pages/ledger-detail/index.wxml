<view class="page form-page">
  <view class="eyebrow">日常收支</view><view class="title">台账详情</view><view class="subtitle">查看这笔记录的完整信息。</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="load">重新加载</button></view>
  <view wx:if="{{!ready && !error}}" class="loading">正在加载…</view>
  <block wx:if="{{ready}}">
    <view class="detail-hero card"><view class="detail-direction {{record.direction}}">{{record.direction === 'income' ? '收入' : '支出'}}</view><view class="detail-amount {{record.direction === 'income' ? 'positive' : 'negative'}}">{{record.direction === 'income' ? '+' : '−'}}{{record.amount}}</view><view class="detail-summary">{{record.summary}}</view><view class="muted">{{record.occurred_on}}</view></view>
    <view class="card"><view class="section-title">基础信息</view><view class="detail-row"><text>资金账户</text><text>{{record.account}}</text></view><view class="detail-row"><text>收支分类</text><text>{{record.category || '未分类'}}</text></view><view class="detail-row"><text>所属部门</text><text>{{record.department || '未指定部门'}}</text></view><view class="detail-row"><text>对方单位</text><text>{{record.counterparty || '未填写'}}</text></view><view class="detail-row"><text>凭证号</text><text>{{record.voucher_no || '未填写'}}</text></view></view>
    <view class="card"><view class="section-title">备注</view><view class="detail-remark">{{record.remark || '未填写备注'}}</view></view>
    <view class="card"><view class="row"><view class="section-title">转账凭证</view><button wx:if="{{canEdit}}" class="link" bindtap="uploadProof" disabled="{{uploading}}">{{uploading ? '上传中…' : '＋ 上传图片'}}</button></view><view wx:if="{{record.attachments.length}}" class="proof-list"><view wx:for="{{record.attachments}}" wx:key="id" class="proof-item"><image class="proof-image" src="{{item.file_url}}" mode="aspectFill"/><view class="proof-name">{{item.original_name}}</view></view></view><view wx:else class="muted proof-empty">{{canEdit ? '暂无转账凭证，可上传银行回单或转账截图' : '暂无转账凭证'}}</view></view>
    <view wx:if="{{record.payroll_batch_id}}" class="notice">这笔流水关联工资批次 #{{record.payroll_batch_id}}，不能直接修改或删除。</view>
  </block>
  <view class="form-footer"><button class="secondary" bindtap="back">返回列表</button><button wx:if="{{ready && canEdit && !record.payroll_batch_id}}" class="primary" bindtap="edit">编辑这笔记录</button></view>
</view>
