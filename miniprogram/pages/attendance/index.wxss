.toolbar { padding: 24rpx; }.toolbar-line { display: flex; align-items: center; gap: 18rpx; }.toolbar-line .label { margin: 0; }.toolbar-line picker { flex: 1; }.picker-value { color: #162033; }.inline-search { margin: 20rpx 0 0; }.record-card { margin-top: 20rpx; padding: 26rpx; }.record-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }.record-main { flex: 1; min-width: 0; }.record-name { font-size: 30rpx; font-weight: 600; }.record-actions { display: flex; flex: 0 0 auto; align-items: center; gap: 18rpx; padding-top: 2rpx; white-space: nowrap; }.record-actions .link { padding: 0; line-height: 1.5; }.danger { color: #d64545; font-size: 25rpx; }.record-line { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 24rpx; color: #475467; font-size: 25rpx; }.reason { margin-top: 16rpx; line-height: 1.6; }.mask { position: fixed; z-index: 20; inset: 0; background: rgba(15, 23, 42, .48); padding: 40rpx 28rpx; }.dialog { max-height: 90vh; overflow-y: auto; background: #fff; border-radius: 28rpx; padding: 30rpx; }.close { font-size: 42rpx; color: #718096; }.employee-picker { max-height: 250rpx; overflow-y: auto; border: 1rpx solid #e1e7ef; border-radius: 18rpx; padding: 12rpx 20rpx; }.employee-option { display: block; padding: 14rpx 0; font-size: 25rpx; border-bottom: 1rpx solid #f0f2f7; }.employee-option:last-child { border-bottom: 0; }.date-add { display: flex; align-items: center; gap: 16rpx; }.date-add picker { flex: 1; }.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }.chip { background: #edf2ff; color: #2457e6; border-radius: 12rpx; padding: 10rpx 14rpx; font-size: 23rpx; }.chip text { margin-left: 8rpx; }.reason-input { height: 130rpx; }.dialog-footer { display: flex; justify-content: flex-end; gap: 18rpx; padding-top: 28rpx; margin-top: 28rpx; border-top: 1rpx solid #e6eaf0; }.dialog-footer button { padding: 18rpx 26rpx; }
