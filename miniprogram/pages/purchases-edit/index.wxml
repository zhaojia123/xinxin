<view class="page form-page"><view class="eyebrow">供货采购</view><view class="title">{{id ? '修改采购明细' : '新增采购明细'}}</view><view class="subtitle">一行记录一种菜品或物料，保存后会自动计算总价。</view><view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="load">重新加载</button></view><view wx:if="{{!ready && !error}}" class="loading">正在加载…</view><block wx:if="{{ready}}"><view class="card"><view class="section-title">采购信息</view><view class="field"><view class="label">采购日期<text class="required">*</text></view><picker mode="date" value="{{form.date}}" data-field="date" bindchange="input" disabled="{{saving}}"><view class="control picker-row"><text>{{form.date}}</text><text class="chevron">›</text></view></picker></view><view class="field"><view class="label">供货商<text class="required">*</text></view><input class="control" value="{{form.supplier_name}}" data-field="supplier_name" bindinput="input" placeholder="例如：张记菜行" maxlength="64" disabled="{{saving}}"/></view><view class="field"><view class="label">采购品类<text class="required">*</text></view><picker range="{{categories}}" range-key="name" bindchange="categoryChanged" disabled="{{saving}}"><view class="control picker-row"><text>{{form.category}}</text><text class="chevron">›</text></view></picker></view><view class="field"><view class="label">菜品或物料<text class="required">*</text></view><input class="control" value="{{form.product_name}}" data-field="product_name" bindinput="input" placeholder="例如：大白菜、食盐、猪肉" maxlength="128" disabled="{{saving}}"/></view></view><view class="card"><view class="section-title">数量与价格</view><view class="field-row"><view class="field"><view class="label">数量<text class="required">*</text></view><input class="control" type="digit" value="{{form.quantity}}" data-field="quantity" bindinput="input" placeholder="1" maxlength="13" disabled="{{saving}}"/></view><view class="field"><view class="label">单位<text class="required">*</text></view><input class="control" value="{{form.unit}}" data-field="unit" bindinput="input" placeholder="斤、箱、袋" maxlength="16" disabled="{{saving}}"/></view></view><view class="field"><view class="label">单价（元）<text class="required">*</text></view><input class="control" type="digit" value="{{form.unit_price}}" data-field="unit_price" bindinput="input" placeholder="0.00" maxlength="13" disabled="{{saving}}"/></view><view class="purchase-total-box"><text>本行总价</text><text>¥{{total}}</text></view></view><view class="card"><view class="section-title">特殊需求</view><textarea class="control" value="{{form.remark}}" data-field="remark" bindinput="input" placeholder="例如：切片、去皮、明早送到" maxlength="500" disabled="{{saving}}"/></view></block><view class="form-footer"><button class="secondary" bindtap="back" disabled="{{saving}}">返回</button><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{!ready || saving}}">{{saving ? '保存中…' : '保存采购'}}</button></view></view>
