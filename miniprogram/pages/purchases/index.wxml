<view class="page">
  <view class="row"><view><view class="eyebrow">每天要什么</view><view class="title">供货采购</view></view><button wx:if="{{canCreate}}" class="primary small-button" bindtap="add">＋ 新增</button></view>
  <view class="subtitle">记录今天要买的菜品、数量和价格。</view>
  <view class="toolbar-card card"><view class="date-range"><picker mode="date" value="{{start_date}}" data-field="start_date" bindchange="dateChanged"><view class="date-picker">{{start_date}}</view></picker><text>至</text><picker mode="date" value="{{end_date}}" data-field="end_date" bindchange="dateChanged"><view class="date-picker">{{end_date}}</view></picker><button class="link" bindtap="today">今天</button></view><button class="export-button" bindtap="exportExcel">导出 Excel</button></view>
  <view class="purchase-totals card"><view class="section-title">品类合计</view><view wx:if="{{totals.length}}" class="total-list"><view wx:for="{{totals}}" wx:key="category" class="total-item"><text>{{item.category}}</text><text>¥{{item.total_price}}</text></view></view><view wx:else class="muted">当前日期暂无采购记录</view></view>
  <view class="section-title purchase-heading">采购明细</view>
  <view class="purchase-item card" wx:for="{{records}}" wx:key="id"><view class="purchase-top"><view class="purchase-category">{{item.category}}</view><view class="purchase-name">{{item.product_name}}</view><view class="purchase-total">¥{{item.total_price}}</view></view><view class="purchase-meta"><view class="purchase-measures"><text class="purchase-measure-label">数量</text><text class="purchase-quantity">{{item.quantity}}</text><text class="purchase-unit">{{item.unit}}</text><text class="purchase-unit-price">单价 ¥{{item.unit_price}}</text></view></view><view wx:if="{{item.modified}}" class="purchase-updated"><text class="purchase-updated-label">已修改</text><text>最近更新：{{item.changed_at}}</text><text class="purchase-change-detail">{{item.change_detail}}</text></view><view wx:if="{{item.remark}}" class="purchase-remark"><text class="purchase-remark-label">备注</text><text class="purchase-remark-text">{{item.remark}}</text></view><text class="purchase-supplier">{{item.date}} · {{item.supplier_name}}</text><view wx:if="{{canEdit || canDelete}}" class="purchase-actions"><text wx:if="{{canEdit}}" catchtap="edit" data-id="{{item.id}}">编辑 ›</text><button wx:if="{{canDelete}}" class="mini-danger" catchtap="remove" data-id="{{item.id}}">删除</button></view></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="retry">重新加载</button></view><view wx:if="{{loading}}" class="loading">正在整理采购清单…</view><view wx:if="{{loaded && !records.length && !loading && !error}}" class="empty card"><view class="empty-mark">采</view><view class="empty-title">这个日期暂无采购</view><view>{{canCreate ? '先添加今天要向供货商采购的菜品吧' : '当前账号只有查看权限'}}</view><button wx:if="{{canCreate}}" class="link" bindtap="add">＋ 添加采购明细</button></view>
</view>
