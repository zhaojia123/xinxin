.toolbar-card { margin-top: 28rpx; padding: 22rpx; }.toolbar-card .date-range { margin: 0; }.date-picker { min-width: 190rpx; padding: 12rpx 14rpx; border-radius: 14rpx; background: #f2f5fa; color: #344054; text-align: center; font-size: 23rpx; }.export-button { width: 100%; margin-top: 18rpx; padding: 14rpx; border: 1rpx solid #c7d7fe; border-radius: 14rpx; color: #2457e6; background: #f4f7ff; font-size: 25rpx; }.export-button::after { border: 0; }.purchase-totals { margin-top: 20rpx; padding: 24rpx; }.total-list { display: flex; flex-wrap: wrap; gap: 14rpx; }.total-item { padding: 12rpx 16rpx; border-radius: 999rpx; color: #475467; background: #f4f6fa; font-size: 23rpx; }.total-item text + text { margin-left: 10rpx; color: #b42318; font-weight: 600; }.purchase-heading { margin-top: 34rpx; }.purchase-item { margin-top: 16rpx; padding: 24rpx; }.purchase-top { display: flex; align-items: center; gap: 14rpx; }.purchase-category { padding: 7rpx 10rpx; border-radius: 10rpx; color: #2457e6; background: #edf2ff; font-size: 21rpx; }.purchase-name { flex: 1; min-width: 0; font-size: 29rpx; font-weight: 600; }.purchase-total { color: #b42318; font-size: 29rpx; font-weight: 650; }.purchase-meta { margin-top: 14rpx; color: #718096; font-size: 22rpx; }.purchase-supplier { display: block; margin-top: 12rpx; color: #718096; font-size: 21rpx; }.purchase-measures { display: flex; align-items: center; gap: 10rpx; margin-top: 0; padding: 12rpx 14rpx; border-radius: 12rpx; background: #f7f9fc; }.purchase-measure-label { padding: 5rpx 9rpx; border-radius: 8rpx; color: #2457e6; background: #e8efff; font-size: 21rpx; font-weight: 600; }.purchase-quantity { color: #16213a; font-size: 31rpx; font-weight: 800; line-height: 1; }.purchase-unit { padding: 4rpx 9rpx; border-radius: 8rpx; color: #2457e6; background: #e8efff; font-size: 24rpx; font-weight: 700; }.purchase-unit-price { margin-left: auto; color: #b42318; font-size: 23rpx; font-weight: 650; white-space: nowrap; }.purchase-updated { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-top: 12rpx; padding: 10rpx 12rpx; border: 1rpx solid #ffd6ae; border-radius: 10rpx; color: #b54708; background: #fff8f0; font-size: 21rpx; }.purchase-updated-label { padding: 5rpx 9rpx; border-radius: 8rpx; color: #9a3412; background: #ffead5; font-weight: 700; }.purchase-change-detail { flex-basis: 100%; color: #9a3412; line-height: 1.5; }.purchase-remark { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 12rpx; padding: 14rpx; border: 1rpx solid #f4d9a6; color: #7a4b00; background: #fffaf0; border-radius: 10rpx; font-size: 22rpx; }.purchase-remark-label { flex: none; padding: 5rpx 9rpx; border-radius: 8rpx; color: #8a5a00; background: #ffe8ad; font-weight: 700; }.purchase-remark-text { flex: 1; line-height: 1.5; }.purchase-actions { display: flex; justify-content: flex-end; gap: 24rpx; margin-top: 16rpx; border-top: 1rpx solid #f0f2f7; padding-top: 14rpx; color: #2457e6; font-size: 23rpx; }.purchase-actions .mini-danger { margin: 0; padding: 0; border: 0; color: #d64545; background: transparent; font-size: 23rpx; }.purchase-actions .mini-danger::after { border: 0; }
