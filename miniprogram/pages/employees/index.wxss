.stats { display: flex; padding: 32rpx 20rpx; }
.stats > view { width: 33.33%; text-align: center; border-right: 1rpx solid #e6eaf0; }.stats > view:last-child { border: 0; }
.stats text { display: block; font-size: 23rpx; }.stats .count { font-size: 43rpx; font-weight: 700; margin-bottom: 14rpx; }.blue { color: #2457e6; }
.filter { padding: 15rpx 24rpx; }
.health-reminder { margin-top: 24rpx; padding: 26rpx; }
.health-count { color: #b54708; font-size: 30rpx; font-weight: 700; }
.health-names { display: flex; flex-wrap: wrap; gap: 12rpx 18rpx; margin-top: 20rpx; color: #b54708; font-size: 24rpx; }
.employee-card { margin-top: 20rpx; padding: 27rpx; }
.employee-top { display: flex; align-items: center; }.avatar { width: 80rpx; height: 80rpx; border-radius: 24rpx; background: #edf2ff; color: #2457e6; text-align: center; line-height: 80rpx; font-size: 34rpx; font-weight: 600; margin-right: 22rpx; flex-shrink: 0; }
.employee-main { flex: 1; min-width: 0; }.employee-name { font-size: 31rpx; font-weight: 600; }.status { margin-left: 16rpx; padding: 6rpx 12rpx; border-radius: 10rpx; font-size: 21rpx; font-weight: 400; background: #f0f3f7; color: #718096; }
.status.active { background: #eaf7f1; color: #16825d; }.status.pending { background: #edf2ff; color: #2457e6; }
.employee-no { font-size: 23rpx; color: #98a2b3; margin-top: 12rpx; }
.employee-detail { margin-top: 26rpx; display: flex; flex-direction: column; gap: 12rpx; color: #475467; font-size: 24rpx; }
.employee-bottom { display: flex; justify-content: space-between; gap: 12rpx; border-top: 1rpx solid #f0f2f7; padding-top: 22rpx; margin-top: 24rpx; font-size: 22rpx; color: #98a2b3; }.health.active { color: #16825d; }.health.warning { color: #b54708; }.health.inactive { color: #dc5c50; }
.employee-actions, .entry-actions { display: flex; align-items: center; gap: 18rpx; }
.detail-label { color: #2457e6; }
.edit-label { color: #718096; }
.mini-danger { margin: 0; padding: 0; border: 0; background: transparent; color: #d64545; font-size: 22rpx; line-height: 1.5; }
.mini-danger::after { border: 0; }
