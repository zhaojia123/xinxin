page { background: #f3f6ff; }
.login-page { position: relative; min-height: 100vh; overflow: hidden; padding: 74rpx 44rpx calc(70rpx + env(safe-area-inset-bottom)); background: linear-gradient(155deg,#f8faff 0%,#eef3ff 52%,#f7f9fd 100%); }
.login-atmosphere { position: absolute; border-radius: 50%; filter: blur(2rpx); pointer-events: none; }.atmosphere-one { width: 430rpx; height: 430rpx; top: -210rpx; right: -160rpx; background: rgba(103,139,255,.22); }.atmosphere-two { width: 330rpx; height: 330rpx; bottom: 80rpx; left: -230rpx; background: rgba(103,199,170,.12); }
.login-content { position: relative; z-index: 1; }.login-header { display: flex; align-items: center; gap: 20rpx; margin-bottom: 72rpx; }.brand-mark { width: 88rpx; height: 88rpx; flex: 0 0 88rpx; background: linear-gradient(145deg,#3d71f3,#173aa1); color: #fff; font-size: 43rpx; font-weight: 700; text-align: center; line-height: 88rpx; border-radius: 27rpx; box-shadow: 0 16rpx 34rpx rgba(36,87,230,.24); }.product-name { color: #172440; font-size: 28rpx; font-weight: 700; }.product-subtitle { margin-top: 7rpx; color: #7b89a4; font-size: 22rpx; letter-spacing: 1rpx; }
.eyebrow { display: inline-flex; padding: 10rpx 18rpx; border-radius: 99rpx; background: rgba(255,255,255,.7); color: #2457e6; font-size: 22rpx; font-weight: 600; letter-spacing: 1rpx; box-shadow: 0 4rpx 12rpx rgba(36,87,230,.06); }.login-title { max-width: 620rpx; color: #172440; font-size: 58rpx; font-weight: 700; line-height: 1.28; margin-top: 24rpx; letter-spacing: -2rpx; }.blue { color: #2457e6; }.intro { color: #63718b; font-size: 28rpx; line-height: 1.85; margin-top: 24rpx; }
.preview { padding: 30rpx; border-radius: 32rpx; background: rgba(255,255,255,.9); border: 1rpx solid rgba(218,226,243,.96); margin: 52rpx 0 42rpx; box-shadow: 0 22rpx 54rpx rgba(49,76,133,.08); }.preview-top { display: flex; align-items: center; justify-content: space-between; color: #1a2741; font-size: 28rpx; font-weight: 700; }.preview-caption { display: block; margin-top: 7rpx; color: #94a0b4; font-size: 21rpx; font-weight: 400; }.preview-badge { padding: 9rpx 14rpx; border-radius: 14rpx; background: #edf2ff; color: #3563d8; font-size: 21rpx; font-weight: 500; }.feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 28rpx; }.feature-item { min-width: 0; padding: 22rpx 16rpx; border-radius: 22rpx; background: #f7f9ff; }.mini-mark { width: 58rpx; height: 58rpx; border-radius: 18rpx; background: #e9efff; color: #2457e6; text-align: center; line-height: 58rpx; font-size: 26rpx; }.green { background: #e7f7ef; color: #16825d; }.preview-copy { margin-top: 16rpx; }.preview-copy text { display: block; color: #273653; font-size: 25rpx; font-weight: 600; }.preview-copy .muted { margin-top: 8rpx; color: #8793a7; font-size: 20rpx; font-weight: 400; line-height: 1.5; }
.login-button { width: 100%; padding: 27rpx; border-radius: 22rpx; font-size: 30rpx; box-shadow: 0 14rpx 30rpx rgba(36,87,230,.22); }.login-note { font-size: 21rpx; color: #96a1b4; text-align: center; margin-top: 22rpx; }.filing-info { position: relative; z-index: 1; color: #9aa5b8; font-size: 21rpx; line-height: 1.6; text-align: center; margin-top: 34rpx; }.settings-link { position: relative; z-index: 1; margin: 28rpx auto 0; font-size: 23rpx; color: #718096; }.secondary { margin-top: 20rpx; }
